# AI Keys
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here

# Redis — use Upstash (free, copy the redis:// URL from their dashboard)
REDIS_URL=redis://default:password@your-upstash-url.upstash.io:6379

# Postgres — use Supabase (free, copy the postgres:// URL from their dashboard)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Tesseract — on Linux Docker this is just the binary name, not a Windows path
TESSERACT_PATH=tesseract

# App
DEMO_MODE=true
DEMO_URL=http://localhost:8080/static/udyam_mock.html